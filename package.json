{
  "name": "p-dash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local control room for long-running development processes",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/*.test.js",
    "cli": "node bin/pdash.js",
    "mcp": "node bin/mcp.js",
    "demo": "node scripts/seed.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.9",
    "vite": "^7.2.0"
